# Local PostgreSQL (Docker / EC2)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_queue

# Database connection URL:
# For docker-compose: postgresql://postgres:postgres@postgres:5432/job_queue
# For local host process: postgresql://postgres:postgres@localhost:5432/job_queue
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/job_queue
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_HOST=127.0.0.1
API_PORT=8000